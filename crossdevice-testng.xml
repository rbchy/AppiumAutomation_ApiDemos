<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- The enterprise checks on two emulators at once (local use: start both AVDs first).
     mvn test -DsuiteXmlFile=crossdevice-testng.xml -->
<suite name="CrossDeviceSuite" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="listeners.ScreenshotListener"/>
    </listeners>

    <test name="Emulator 5554">
        <parameter name="deviceName" value="emulator-5554"/>
        <classes>
            <class name="tests.EnterpriseTestSuite"/>
        </classes>
    </test>

    <test name="Emulator 5556">
        <parameter name="deviceName" value="emulator-5556"/>
        <classes>
            <class name="tests.EnterpriseTestSuite"/>
        </classes>
    </test>

</suite>
