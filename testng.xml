<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Full regression run on one Android emulator (emulator-5554). -->
<suite name="ApiDemosRegressionSuite" verbose="1">

    <parameter name="deviceName" value="emulator-5554"/>

    <listeners>
        <listener class-name="listeners.ScreenshotListener"/>
    </listeners>

    <test name="Install Lifecycle Tests">
        <classes>
            <class name="tests.InstallLifecycleTests"/>
        </classes>
    </test>

    <test name="Combined Core + Advanced Tests">
        <classes>
            <class name="tests.CombinedApiDemosTests"/>
        </classes>
    </test>

    <test name="Enterprise Test Categories">
        <classes>
            <class name="tests.EnterpriseTestSuite"/>
        </classes>
    </test>

    <test name="Interrupt Simulation Tests">
        <classes>
            <class name="tests.InterruptSimulationTests"/>
        </classes>
    </test>

    <test name="Device Integration Tests (deep link, notification, clipboard)">
        <classes>
            <class name="tests.DeviceIntegrationTests"/>
        </classes>
    </test>

    <test name="API Integration Tests">
        <classes>
            <class name="tests.ApiIntegratedTests"/>
        </classes>
    </test>

</suite>
